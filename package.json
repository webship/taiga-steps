{
  "name": "@webship-js/taiga-steps",
  "version": "2.0.0",
  "description": "Cucumber step definitions for Taiga, the open-source agile project management platform, a pack for webship-js (Playwright and Cucumber): signing in and out and its refusal, a project and who may open it, its backlog and its sprints, the taskboard of a sprint and the Kanban board, one user story (its status, comments, tags, assigned users, creator, tasks and sprint), a new user story, and what a reader of the project or someone it does not have may not do. Test content is made and removed through the site's own REST API, so a run leaves the site as it found it.",
  "main": "tests/step-definitions/taiga-helpers.js",
  "files": [
    "tests/step-definitions/",
    "tests/features/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:dry": "cucumber-js --config cucumber.js --dry-run",
    "test:examples": "node tests/check-examples.js",
    "test:paths": "node tests/check-paths.js",
    "test:must-fail": "node tests/check-must-fail.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports",
    "test:fast": "SLOW_MO=0 cucumber-js --config cucumber.js"
  },
  "keywords": [
    "webship-js",
    "taiga",
    "agile",
    "scrum",
    "kanban",
    "user-stories",
    "cucumber",
    "cucumber-js",
    "playwright",
    "bdd",
    "gherkin",
    "step-definitions",
    "e2e-testing"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/taiga-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/taiga-steps/issues"
  },
  "homepage": "https://github.com/webship/taiga-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 24.0"
  },
  "peerDependencies": {
    "webship-js": "^2.0.16"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "webship-js": "^2.0.17"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
